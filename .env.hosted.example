# Copy to a private file outside version control and pass it with --env-file.
MCP_COMPOSER_VERSION=0.1.0
MCP_COMPOSER_IMAGE=ghcr.io/feg55/mcp-composer
MCP_COMPOSER_DOMAIN=composer.example.com
MCP_COMPOSER_USERNAME=composer
# Generate interactively with:
# docker run --rm -it caddy:2.11.4-alpine caddy hash-password
# Keep the single quotes so Compose treats dollar signs literally.
MCP_COMPOSER_PASSWORD_HASH='$2a$14$replace-with-a-caddy-password-hash'
# Exact comma-separated HTTPS MCP hostnames allowed for outbound connections.
MCP_COMPOSER_REMOTE_HOSTS=
