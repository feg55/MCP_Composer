# Docker Compose defaults for local hosted-mode testing
MCP_COMPOSER_PORT=8000
# Optional override for a reverse proxy or a non-local browser origin
# MCP_COMPOSER_ALLOWED_ORIGINS=https://composer.example.com
MCP_COMPOSER_ALLOWED_HOSTS=localhost,127.0.0.1

# Exact HTTPS MCP hostnames permitted for outbound hosted connections
MCP_COMPOSER_REMOTE_HOSTS=
