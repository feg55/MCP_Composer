{
  "servers": [
    {
      "id": "github-mcp",
      "name": "GitHub MCP",
      "description": "GitHub repository, issue, pull request, and file operations through the official remote GitHub MCP server.",
      "transport": "http",
      "source": "official",
      "command": null,
      "args": [],
      "url": "https://api.githubcopilot.com/mcp/",
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "headers": {
        "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
      },
      "tags": ["code", "git", "issues", "pull-requests"],
      "status": "needs_auth",
      "tools": []
    },
    {
      "id": "filesystem-mcp",
      "name": "Filesystem MCP",
      "description": "Local workspace file discovery and read/write operations through a configured filesystem root.",
      "transport": "stdio",
      "source": "registry",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-filesystem", "."],
      "url": null,
      "env": {},
      "tags": ["files", "workspace", "local"],
      "status": "ready",
      "tools": []
    },
    {
      "id": "postgresql-mcp",
      "name": "PostgreSQL MCP",
      "description": "Database query and schema inspection for a PostgreSQL connection string.",
      "transport": "stdio",
      "source": "registry",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-postgres", "${DATABASE_URL}"],
      "url": null,
      "env": {
        "DATABASE_URL": "${DATABASE_URL}"
      },
      "tags": ["database", "sql", "analytics"],
      "status": "needs_auth",
      "tools": []
    },
    {
      "id": "slack-mcp",
      "name": "Slack MCP",
      "description": "Slack workspace search, channel, and message operations.",
      "transport": "stdio",
      "source": "registry",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-slack"],
      "url": null,
      "env": {
        "SLACK_BOT_TOKEN": "${SLACK_BOT_TOKEN}",
        "SLACK_TEAM_ID": "${SLACK_TEAM_ID}"
      },
      "tags": ["chat", "collaboration", "messages"],
      "status": "needs_auth",
      "tools": []
    },
    {
      "id": "browser-search-mcp",
      "name": "Browser/Search MCP",
      "description": "HTTP MCP endpoint for browser, search, and page fetching workflows.",
      "transport": "http",
      "source": "registry",
      "command": null,
      "args": [],
      "url": "http://localhost:8765/mcp",
      "env": {},
      "tags": ["browser", "search", "research"],
      "status": "ready",
      "tools": []
    },
    {
      "id": "linear-mcp",
      "name": "Linear MCP",
      "description": "Linear issue, project, and team workflow operations.",
      "transport": "stdio",
      "source": "registry",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-linear"],
      "url": null,
      "env": {
        "LINEAR_API_KEY": "${LINEAR_API_KEY}"
      },
      "tags": ["planning", "issues", "product"],
      "status": "needs_auth",
      "tools": []
    },
    {
      "id": "notion-mcp",
      "name": "Notion MCP",
      "description": "Notion page search, reading, and content management through an upstream MCP server.",
      "transport": "stdio",
      "source": "registry",
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-notion"],
      "url": null,
      "env": {
        "NOTION_API_KEY": "${NOTION_API_KEY}"
      },
      "tags": ["docs", "knowledge-base", "notes"],
      "status": "needs_auth",
      "tools": []
    },
    {
      "id": "docker-mcp",
      "name": "Docker MCP",
      "description": "Docker container listing, inspection, restart, and lifecycle operations.",
      "transport": "stdio",
      "source": "github",
      "command": "npx",
      "args": ["-y", "mcp-server-docker"],
      "url": null,
      "env": {},
      "tags": ["devops", "containers", "local"],
      "status": "ready",
      "tools": []
    }
  ]
}
