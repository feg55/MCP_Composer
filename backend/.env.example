# local enables stdio MCP processes and detailed upstream errors
# hosted blocks stdio, private network URLs, and API requests without Origin
# Load this file explicitly with: python -m uvicorn app.main:app --env-file .env
APP_MODE=local

# Comma-separated browser origins allowed to call the API
MCP_COMPOSER_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Comma-separated HTTP Host values accepted by the API
MCP_COMPOSER_ALLOWED_HOSTS=localhost,127.0.0.1

# Exact remote MCP hostnames permitted in hosted mode
# MCP_COMPOSER_REMOTE_HOSTS=mcp.example.com

# Generated gateway artifacts are written here
MCP_COMPOSER_DATA_DIR=./app/generated

# Local defaults to true, hosted defaults to false
MCP_COMPOSER_DOCS_ENABLED=true

# Local defaults to false, hosted defaults to true
MCP_COMPOSER_REQUIRE_ORIGIN=false

# Maximum actual body size for state-changing API requests
MCP_COMPOSER_MAX_REQUEST_BYTES=1000000

# Optional absolute or relative path to a built Vite dist directory
# FRONTEND_DIST_DIR=../frontend/dist
